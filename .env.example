# ============================================
# SHELTRA PROJECT - ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to .env and fill in your values

APP_NAME=Sheltra
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=error

# Backend (Laravel/PHP)
APP_KEY=
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=your-database-host
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Frontend (React/Vite)
VITE_BACKEND_ENDPOINT=https://yourdomain.com
VITE_API_URL=https://yourdomain.com/api
VITE_APP_ENV=production

# AI Integration (Gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Payment Integration (Stripe)
STRIPE_PUBLIC_KEY=pk_live_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_CURRENCY=usd

# phpMyAdmin (Optional)
PMA_HOST=your-database-host
PMA_PORT=3306
PMA_USER=your_username
PMA_PASSWORD=your_password
PMA_DATABASE=your_database
