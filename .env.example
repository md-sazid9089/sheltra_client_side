# ============================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# ============================================
# Copy this to .env in the project root
# Used by docker-compose.yml for all services

# DATABASE CONFIGURATION (MySQL)
DB_PASSWORD=secure_random_password_min_16_chars
DB_DATABASE=sheltra_db
DB_USERNAME=sheltra
DB_PORT=3306

# BACKEND APPLICATION
APP_NAME=Sheltra
APP_ENV=local
APP_DEBUG=false
APP_KEY=base64:generated_by_laravel_key_generate
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=debug

# FRONTEND
VITE_BACKEND_ENDPOINT=http://localhost:8000

# STRIPE (payments)
STRIPE_PUBLIC_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_CURRENCY=usd

# GEMINI AI (CV analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# REDIS (for caching and queues - optional for local dev)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# CACHE & QUEUE (file for dev, redis for production)
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
