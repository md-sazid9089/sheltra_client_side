# ==============================================================================
# SHELTRA PROJECT - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in appropriate values for your environment.
# NEVER commit .env to Git - it contains secrets.
# 
# This file is organized by service/component for easy reference.
#
# Values marked [REQUIRED] must be set before deployment.
# Values marked [OPTIONAL] can be left as-is or customized.
# ==============================================================================

# ==============================================================================
# CORE APPLICATION CONFIGURATION
# ==============================================================================

APP_NAME=Sheltra
APP_ENV=local
# Environments: local, testing, staging, production
# Use: local (dev), testing (CI), staging (pre-prod), production (live)

APP_DEBUG=true
# Set to false in production to hide stack traces

APP_KEY=
# [REQUIRED] Generate with: php artisan key:generate --show
# Format: base64:xxxxxxxxxxxxx...

APP_URL=http://localhost:8000
# [REQUIRED] Backend base URL
# Production: https://api.sheltra.app
# Staging: https://api-staging.sheltra.app

FRONTEND_URL=http://localhost:5173
# Frontend URL (for CORS, email links, redirects)
# Production: https://sheltra.app
# Staging: https://staging.sheltra.app

LOG_CHANNEL=stack
LOG_LEVEL=debug
# Levels: debug, info, notice, warning, error, critical, alert, emergency
# Use debug/info for development, error/critical for production

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

DB_CONNECTION=mysql
# Options: mysql, sqlite, pgsql, sqlsrv

DB_HOST=127.0.0.1
# Localhost for development
# RDS/managed DB hostname for production

DB_PORT=3306
# Standard: 3306 for MySQL, 5432 for PostgreSQL

DB_DATABASE=sheltra_dev
# Development: sheltra_dev
# Testing: sheltra_test (set by CI)
# Production: sheltra_prod

DB_USERNAME=root
# Database user (use limited permissions in production)

DB_PASSWORD=
# Database password
# [REQUIRED] In production, use strong password and store in secrets

# Testing database (used by CI/tests)
DB_CONNECTION_TESTING=sqlite
DB_DATABASE_TESTING=:memory:
# For CI: Use in-memory SQLite for speed
# Local testing: Can override to test database

# ==============================================================================
# CACHE & SESSION CONFIGURATION
# ==============================================================================

CACHE_DRIVER=array
# Options: array, file, database, redis, memcached, dynamodb
# Development: array (in-memory, fast, lost on restart)
# Production: redis (persistent across restarts)

SESSION_DRIVER=file
# Options: file, cookie, database, redis, memcached
# Development: file (simple)
# Production: redis (distributed sessions)

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Redis is optional but recommended for cache/session
# Development: localhost (if Redis installed)
# Production: Managed Redis or ElastiCache

# ==============================================================================
# QUEUE & BACKGROUND JOBS
# ==============================================================================

QUEUE_CONNECTION=sync
# Options: sync, database, redis, sqs, beanstalkd
# Development: sync (process immediately)
# Production: redis (background processing)

QUEUE_FAILED_TABLE=failed_jobs
# Table for failed job logging

# ==============================================================================
# MAIL CONFIGURATION
# ==============================================================================

MAIL_DRIVER=log
# Options: log, smtp, mailgun, postmark, sendgrid, ses, resend
# Development: log (writes to logs, doesn't actually send)
# Production: smtp or managed service

MAIL_HOST=smtp.mailtrap.io
# SMTP server hostname (if using SMTP)

MAIL_PORT=2525
# SMTP port (usually 25, 465, 587, or 2525)

MAIL_USERNAME=
# SMTP authentication username

MAIL_PASSWORD=
# SMTP authentication password

MAIL_ENCRYPTION=tls
# Options: tls, ssl, none
# TLS: port 587
# SSL: port 465

MAIL_FROM_ADDRESS=noreply@sheltra.app
MAIL_FROM_NAME="Sheltra Platform"
# Default sender for transactional emails

# ==============================================================================
# FRONTEND CONFIGURATION (Vite)
# ==============================================================================
# These are used during frontend build (npm run build)
# Prefix: VITE_* (visible in frontend JavaScript)

VITE_API_URL=http://localhost:8000/api
# Frontend API endpoint
# Development: http://localhost:8000/api
# Preview/Staging: https://api-staging.sheltra.app/api
# Production: https://api.sheltra.app/api

VITE_BACKEND_ENDPOINT=http://localhost:8000
# Full backend URL (without /api)
# Used for redirects, external references

VITE_APP_ENV=development
# Application environment visible to frontend
# Options: development, preview, production
# Preview deployments (Vercel): preview
# Production: production

# ==============================================================================
# THIRD-PARTY SERVICES - Payment (Stripe)
# ==============================================================================

STRIPE_PUBLIC_KEY=pk_test_example
# [REQUIRED] Stripe publishable key
# Test key format: pk_test_*
# Live key format: pk_live_*
# Generates on client-side (safe to expose)

STRIPE_SECRET_KEY=sk_test_example
# [REQUIRED] Stripe secret key
# Test key format: sk_test_*
# Live key format: sk_live_*
# KEEP PRIVATE - never expose to frontend
# Store in Render Secrets, not in code

STRIPE_WEBHOOK_SECRET=whsec_test_example
# Webhook signing secret from Stripe dashboard
# Used to verify Stripe event authenticity

STRIPE_CURRENCY=usd
# Default currency for charges

# Frontend Stripe key (Vite visible)
VITE_STRIPE_PUBLIC_KEY=pk_test_example
# Must match STRIPE_PUBLIC_KEY
# Accessible from frontend

# ==============================================================================
# THIRD-PARTY SERVICES - AI (Google Gemini)
# ==============================================================================

GEMINI_API_KEY=
# [REQUIRED] Google Generative AI API key
# Get from: https://aistudio.google.com/app/apikey
# Used for AI features (job recommendations, profile suggestions)

GEMINI_MODEL=gemini-1.5-flash
# Model to use for API calls
# Options: gemini-1.5-flash, gemini-1.5-pro (premium), etc.

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Google Gemini API endpoint (usually doesn't change)

GEMINI_MAX_TOKENS=1000
# Maximum tokens for API response

# ==============================================================================
# OPTIONAL: FILE STORAGE
# ==============================================================================

FILESYSTEM_DISK=local
# Options: local, s3, azure, gcs
# Development: local (files/app/storage/app/public)
# Production: s3 (AWS S3, recommended for scalability)

AWS_ACCESS_KEY_ID=
# AWS access key for S3 (if using S3 storage)

AWS_SECRET_ACCESS_KEY=
# AWS secret key for S3

AWS_DEFAULT_REGION=us-east-1
# AWS region

AWS_BUCKET=sheltra-uploads
# S3 bucket name for file uploads

AWS_URL=https://sheltra-uploads.s3.amazonaws.com
# Public URL for S3 bucket

# ==============================================================================
# OPTIONAL: MONITORING & ERROR TRACKING
# ==============================================================================

SENTRY_DSN=
# Sentry error tracking DSN
# Get from: https://sentry.io/
# Used to track production errors and crashes

SENTRY_ENVIRONMENT=production
# Environment for Sentry (production, staging, development)

# ==============================================================================
# OPTIONAL: ADDITIONAL SERVICES
# ==============================================================================

TWILIO_ACCOUNT_SID=
# Twilio account SID (if SMS notifications needed)

TWILIO_AUTH_TOKEN=
# Twilio auth token

TWILIO_PHONE_NUMBER=
# Twilio phone number for sending SMS

PUSHER_APP_ID=
# Pusher app ID (if real-time notifications needed)

PUSHER_APP_KEY=
# Pusher public key

PUSHER_APP_SECRET=
# Pusher secret key

PUSHER_APP_CLUSTER=us2
# Pusher cluster (us2, eu, ap1, etc.)

# ==============================================================================
# TESTING & CI/CD CONFIGURATION
# ==============================================================================

CI_ENVIRONMENT=true
# Set to true when running in CI/CD (GitHub Actions)
# Can be used to conditionally skip certain tests/operations

TEST_DB_CONNECTION=sqlite
# Test database connection type

# ==============================================================================
# DEPRECATED / LEGACY (Keep for backward compatibility)
# ==============================================================================

BROADCAST_DRIVER=log
# Usually not needed for this project

CACHE_TABLE=cache
# Table name for cache driver

JWT_SECRET=
# If JWT authentication is used (Laravel Sanctum uses app key)

# ==============================================================================
# ENVIRONMENT SETUP EXAMPLES
# ==============================================================================

# LOCAL DEVELOPMENT (.env):
# APP_ENV=local
# APP_DEBUG=true
# DB_HOST=127.0.0.1
# DB_DATABASE=sheltra_dev
# CACHE_DRIVER=array
# QUEUE_CONNECTION=sync
# MAIL_DRIVER=log

# CI/TESTING (.env.testing - auto-generated):
# APP_ENV=testing
# APP_DEBUG=true
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:
# CACHE_DRIVER=array
# QUEUE_CONNECTION=sync

# STAGING DEPLOYMENT (Render):
# APP_ENV=staging
# APP_DEBUG=true
# DB_HOST=staging-db.example.com
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis

# PRODUCTION DEPLOYMENT (Render):
# APP_ENV=production
# APP_DEBUG=false
# DB_HOST=prod-db.example.com
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# MAIL_DRIVER=smtp

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Generate app key: php artisan key:generate
# 2. Never commit .env to Git
# 3. Use .env.example (this file) for documentation
# 4. Use Render UI for production secrets
# 5. Use Vercel UI for frontend environment variables
# 6. Test all settings before deploying to production
# 7. Rotate secrets periodically
# ============================================================================
