# ============================================
# SHELTRA FRONTEND CONFIGURATION (.env.example)
# ============================================
# Copy this file to .env.local and fill in values

# Backend API Endpoint
# For local dev: http://localhost:8000/api
# For production: https://api.sheltra.io/api
VITE_BACKEND_ENDPOINT=http://localhost:8000/api

# Application Environment (development, staging, production)
VITE_APP_ENV=development

# Stripe Public Key (for payments)
VITE_STRIPE_PUBLIC_KEY=pk_test_

# Optional: Analytics, feature flags, etc.
# VITE_GA_ID=
# VITE_SENTRY_DSN=
