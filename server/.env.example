# ============================================
# SHELTRA BACKEND CONFIGURATION (.env.example)
# ============================================
# Copy this file to .env and fill in actual values
# NEVER commit secrets to version control
# Use Azure Key Vault in production

# APP CONFIGURATION
APP_NAME=Sheltra
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# LOGGING & MONITORING
LOG_LEVEL=debug
LOG_CHANNEL=stack

# DATABASE (Aiven MySQL in production, local for dev)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sheltra_db
DB_USERNAME=sheltra
DB_PASSWORD=

# CACHE (File-based for dev, Redis in production)
CACHE_DRIVER=file
CACHE_PREFIX=sheltra_

# QUEUE (Sync for dev, Redis in production)
QUEUE_CONNECTION=sync

# REDIS (for caching and queues)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# STRIPE PAYMENT INTEGRATION
STRIPE_PUBLIC_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_CURRENCY=usd
STRIPE_WEBHOOK_ENDPOINT_SECRET=

# GEMINI AI API (for CV analysis and skill matching)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# MAIL (for notifications and verification emails)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@sheltra.io
MAIL_FROM_NAME=Sheltra

# SESSION
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# ============================================
# Production: Use Azure Key Vault or GitHub Secrets
# Development: Copy to .env and fill in test values
# ============================================
