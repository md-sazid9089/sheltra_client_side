# ============================================
# SHELTRA AZURE PRODUCTION CONFIGURATION
# ============================================
# Use Azure Key Vault or GitHub Secrets in GitHub Actions
# DO NOT commit this file with real secrets
# Pattern: Load from Azure Key Vault during deployment

# APP CONFIGURATION
APP_NAME=Sheltra
APP_ENV=production
APP_DEBUG=false
APP_KEY=${AZURE_KEY_VAULT_APP_KEY}
APP_URL=https://sheltra.azurewebsites.net
FRONTEND_URL=https://sheltra.azurewebsites.net
LOG_LEVEL=info

# DATABASE (Aiven-hosted MySQL)
DB_CONNECTION=mysql
DB_HOST=${AZURE_MYSQL_HOST}
DB_PORT=3306
DB_DATABASE=${AZURE_MYSQL_DATABASE}
DB_USERNAME=${AZURE_MYSQL_USERNAME}
DB_PASSWORD=${AZURE_MYSQL_PASSWORD}

# CACHE (Redis in production)
CACHE_DRIVER=redis
CACHE_PREFIX=sheltra_prod_
REDIS_HOST=${AZURE_REDIS_HOST}
REDIS_PORT=6380
REDIS_PASSWORD=${AZURE_REDIS_PASSWORD}

# QUEUE (Redis-backed queues in production)
QUEUE_CONNECTION=redis

# STRIPE
STRIPE_PUBLIC_KEY=${AZURE_STRIPE_PUBLIC_KEY}
STRIPE_SECRET_KEY=${AZURE_STRIPE_SECRET_KEY}
STRIPE_CURRENCY=usd
STRIPE_WEBHOOK_ENDPOINT_SECRET=${AZURE_STRIPE_WEBHOOK_SECRET}

# GEMINI AI
GEMINI_API_KEY=${AZURE_GEMINI_API_KEY}
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# MAIL (SendGrid or AWS SES)
MAIL_MAILER=sendgrid
MAIL_FROM_ADDRESS=noreply@sheltra.io
MAIL_FROM_NAME=Sheltra
SENDGRID_API_KEY=${AZURE_SENDGRID_API_KEY}

# LOGGING & MONITORING
LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=${AZURE_SLACK_WEBHOOK}

# SESSION
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# CORS
SESSION_DOMAIN=sheltra.azurewebsites.net
